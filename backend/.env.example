# ============================================================
#  BACKEND ENVIRONMENT VARIABLES
#  Copy to .env and fill in your credentials
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# MQTT Broker (HiveMQ Cloud)
MQTT_BROKER=d0e0ce8ffc364fe4b5c641f8f84ef0a1.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=thesis_pi
MQTT_PASSWORD=H@rveypads123

# MQTT Topics to subscribe
MQTT_TOPICS=rice/sensors,rice/image,rice/detection

# CORS allowed origins
CORS_ORIGIN=http://localhost:5173,https://your-vercel-app.vercel.app

# Logging
LOG_LEVEL=info
