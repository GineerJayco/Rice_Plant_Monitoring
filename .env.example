# Smart Irrigation System API Configuration

# API Base URL (Update with your Raspberry Pi IP address)
# Local development
VITE_API_URL=http://localhost:5000

# Force demo mode (uses mock data + local mock camera images)
# Set to true when the backend API is not available.
VITE_USE_MOCK=false

# Optional: if your backend serves images from a different host/port
# VITE_IMAGE_BASE_URL=http://192.168.1.100:5000

# Raspberry Pi on network (example)
# VITE_API_URL=http://192.168.1.100:5000

# Production (if deployed)
# VITE_API_URL=https://api.yourdomain.com
